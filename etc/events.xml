<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_success">
        <observer name="hryvinskyi_test_order_link_test_order"
                  instance="Hryvinskyi\TestOrder\Observer\LinkTestOrder"/>
    </event>
    <event name="order_cancel_after">
        <observer name="hryvinskyi_test_order_undo_test_order_on_cancel"
                  instance="Hryvinskyi\TestOrder\Observer\UndoTestOrderOnCancel"/>
    </event>
</config>
