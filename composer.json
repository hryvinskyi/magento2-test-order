{
    "name": "hryvinskyi/magento2-test-order",
    "description": "Test orders the shop recognises: the end-to-end runner's proof, the record of a recognised cart, the question every integration asks before it acts on an order, and ending a test order",
    "type": "magento2-module",
    "version": "1.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "magento/framework": "*",
        "magento/module-backend": "*",
        "magento/module-config": "*",
        "magento/module-cron": "*",
        "magento/module-quote": "*",
        "magento/module-sales": "*",
        "magento/module-store": "*",
        "magento/module-webapi": "*",
        "psr/log": "^1 || ^2 || ^3"
    },
    "require-dev": {
        "magento/module-inventory-api": "*",
        "magento/module-inventory-reservations": "*",
        "magento/module-inventory-sales-api": "*",
        "magento/module-payment": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\TestOrder\\": ""
        }
    }
}
